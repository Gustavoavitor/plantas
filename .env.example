# ------------------------------------------------------------------
# Copie este arquivo para .env.local e preencha com os seus valores.
# .env.local NUNCA vai para o GitHub (já está no .gitignore).
# ------------------------------------------------------------------

# --- Supabase ---
# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" — ignora o RLS. Só no servidor, nunca no navegador.
# NUNCA coloque um prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=

# --- APIs de plantas ---
# https://my.plantnet.org/  (500 identificações por dia no plano grátis)
PLANTNET_API_KEY=

# https://perenual.com/docs/api  (dados de cultivo e rega)
PERENUAL_API_KEY=

# --- Notificações push ---
# Já geradas para este projeto. Se quiser trocar:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ASSUNTO=mailto:seu@email.com

# --- Cron ---
# Segredo que protege /api/cron/lembretes. Gere um valor aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Endereço público do app. Em produção a Vercel preenche sozinha,
# mas o cron precisa saber para montar os links da notificação.
NEXT_PUBLIC_URL=http://localhost:3000
